generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  DRIVER
}
enum Service {
  REPAIR
  MOBILE_CARWASH
  PERIODIC_SERVICE
  TOWING
  INSPECTION
}
enum RequestStatus {
  PENDING
  ACCEPTED
  ARRIVED
  COMPLETED
  CANCELLED
}
model User {
  id String @id @default(uuid())
  role Role
  fullName String
  phone String
  nationalId String
  passwordHash String
  vehiclePlate String?
  vehicleType String?
  services Service[]
  identityDocumentId String? @unique
  identityDocument Document? @relation("Identity", fields: [identityDocumentId], references: [id])
  documents Document[] @relation("OwnedDocuments")
  vehicles Vehicle[]
  sessions Session[]
  requests AssistanceRequest[] @relation("CustomerRequests")
  assignments AssistanceRequest[] @relation("DriverRequests")
  telemetry UserLocation?
  location DriverLocation?
  earnings DriverEarning[]
  createdAt DateTime @default(now())
  @@unique([role, phone])
  @@unique([role, nationalId])
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Document {
  id String @id @default(uuid())
  storageKey String @unique
  mimeType String
  ownerId String?
  owner User? @relation("OwnedDocuments", fields: [ownerId], references: [id])
  identityFor User? @relation("Identity")
  vehicleId String?
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  uploadTokenHash String?
  createdAt DateTime @default(now())
}
model Vehicle {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  plate String
  documents Document[]
}
model AssistanceRequest {
  id String @id @default(uuid())
  customerId String
  customer User @relation("CustomerRequests", fields: [customerId], references: [id])
  driverId String?
  driver User? @relation("DriverRequests", fields: [driverId], references: [id])
  service Service
  status RequestStatus @default(PENDING)
  vehicleName String
  vehiclePlate String
  vehicleModelId String?
  vehicleModel VehicleModel? @relation(fields: [vehicleModelId], references: [id])
  originProvince String?
  originAddress String?
  destinationAddress String?
  partsQuoteToman Int?
  partsQuoteVersion Int @default(0)
  partsApprovedToman Int?
  driverCommissionConfirmedAt DateTime?
  operationsStartedAt DateTime?
  partsApprovedAt DateTime?
  payment Payment?
  problem String?
  originLat Float
  originLng Float
  destinationLat Float?
  destinationLng Float?
  origin Unsupported("geography(Point,4326)")?
  destination Unsupported("geography(Point,4326)")?
  distanceMeters Int?
  distanceMethod String?
  priceToman Int?
  pricingVersion String?
  pricingBreakdown Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  acceptedAt DateTime?
  @@index([customerId, createdAt])
  @@index([driverId, status])
  @@index([status, service])
}
model TariffGroup {
  id String @id
  title String
  nissanBaseToman Int?
  nissanPerKmToman Int?
  flatbedBaseToman Int?
  flatbedPerKmToman Int?
  version String
  models VehicleModel[]
}
model VehicleModel {
  id String @id
  name String
  normalizedName String @unique
  aliases String[]
  searchText String
  groupId String
  group TariffGroup @relation(fields: [groupId], references: [id])
  requests AssistanceRequest[]
  @@index([groupId])
}
model Payment {
  id String @id @default(uuid())
  requestId String @unique
  request AssistanceRequest @relation(fields: [requestId], references: [id])
  status String @default("AWAITING_TRANSFER")
  serviceToman Int
  partsToman Int
  amountToman Int
  commissionPercent Int
  commissionToman Int
  driverShareToman Int
  cardNumber String
  accountName String
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  attempts PaymentAttempt[]
  earning DriverEarning?
}
model PaymentAttempt {
  id String @id @default(uuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  bankReference String @unique
  transferredAt DateTime
  status String @default("SUBMITTED")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?
  @@index([paymentId, createdAt])
}
model DriverEarning {
  id String @id @default(uuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id])
  driverId String
  driver User @relation(fields: [driverId], references: [id])
  amountToman Int
  commissionToman Int
  createdAt DateTime @default(now())
  @@index([driverId, createdAt])
}
model DriverLocation {
  driverId String @id
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude Float
  longitude Float
  point Unsupported("geography(Point,4326)")?
  recordedAt DateTime
}
model Outbox {
  id String @id @default(uuid())
  requestId String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt])
}

model UserLocation {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude Float
  longitude Float
  province String
  recordedAt DateTime
  @@index([province])
}
