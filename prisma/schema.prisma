generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  DRIVER
}
enum Service {
  REPAIR
  MOBILE_CARWASH
  PERIODIC_SERVICE
  TOWING
  INSPECTION
}
enum RequestStatus {
  PENDING
  EXPIRED
  ACCEPTED
  ARRIVED
  COMPLETED
  CANCELLED
}
model User {
  affiliation DriverAffiliation?
  showroomAccount ShowroomAccount?
  importRequests ImportRequest[]
  id String @id @default(uuid())
  role Role
  fullName String
  phone String
  nationalId String?
  passwordHash String?
  phoneVerifiedAt DateTime?
  deletedAt DateTime?
  isActive Boolean @default(true)
  vehiclePlate String?
  vehicleType String?
  activityCity String?
  activityDistrict String?
  services Service[]
  identityDocumentId String? @unique
  verificationStatus String @default("PENDING")
  verificationVersion Int @default(0)
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  verificationNote String?
  registrationNoticeSeenAt DateTime?
  verificationNoticeSeenAt DateTime?
  identityDocument Document? @relation("Identity", fields: [identityDocumentId], references: [id])
  documents Document[] @relation("OwnedDocuments")
  supportTickets SupportTicket[]
  vehicles Vehicle[]
  sessions Session[]
  requests AssistanceRequest[] @relation("CustomerRequests")
  assignments AssistanceRequest[] @relation("DriverRequests")
  telemetry UserLocation?
  location DriverLocation?
  marketAlerts MarketAlert[]
  earnings DriverEarning[]
  checkouts GatewayCheckout[]
  walletReceipts WalletReceipt[]
  walletEntries WalletEntry[]
  walletDebits WalletDebit[]
  hallListings HallListing[]
  hallOrders HallOrder[]
  hallInquiries HallInquiry[]
  hallPurchases HallConversation[] @relation("HallBuyer")
  hallSales HallConversation[] @relation("HallSeller")
  hallMessages HallMessage[]
  createdAt DateTime @default(now())
  @@index([role, verificationStatus, createdAt])
  @@unique([role, phone])
  @@unique([role, nationalId])
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model CustomerOtpChallenge {
  id String @id @default(uuid())
  phone String
  purpose String
  context String?
  codeHash String
  status String @default("SENDING")
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  sentAt DateTime?
  consumedAt DateTime?
  @@index([phone, createdAt])
  @@index([expiresAt])
}
model Document {
  id String @id @default(uuid())
  storageKey String @unique
  mimeType String
  ownerId String?
  owner User? @relation("OwnedDocuments", fields: [ownerId], references: [id])
  identityFor User? @relation("Identity")
  vehicleId String?
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  uploadTokenHash String?
  verificationKind String?
  vehicleEvidenceType String?
  createdAt DateTime @default(now())
  @@unique([ownerId, verificationKind])
}
model Vehicle {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  plate String
  documents Document[]
  catalogCarId String?
  catalogCar MarketCar? @relation(fields:[catalogCarId],references:[id],onDelete:SetNull)
  productionYear Int?
  mileage Int @default(0)
  maintenanceRecords MaintenanceRecord[]
}
model AssistanceRequest {
  id String @id @default(uuid())
  customerId String
  customer User @relation("CustomerRequests", fields: [customerId], references: [id])
  driverId String?
  driver User? @relation("DriverRequests", fields: [driverId], references: [id])
  service Service
  status RequestStatus @default(PENDING)
  vehicleName String
  vehiclePlate String
  vehicleModelId String?
  vehicleModel VehicleModel? @relation(fields: [vehicleModelId], references: [id])
  originProvince String?
  originAddress String?
  destinationAddress String?
  partsQuoteToman Int?
  partsQuoteVersion Int @default(0)
  partsApprovedToman Int?
  driverCommissionConfirmedAt DateTime?
  operationsStartedAt DateTime?
  partsApprovedAt DateTime?
  payment Payment?
  problem String?
  originLat Float
  originLng Float
  destinationLat Float?
  destinationLng Float?
  origin Unsupported("geography(Point,4326)")?
  destination Unsupported("geography(Point,4326)")?
  distanceMeters Int?
  distanceMethod String?
  priceToman Int?
  pricingVersion String?
  pricingBreakdown Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  acceptedAt DateTime?
  operatorConfirmedAt DateTime?
  operatorActorId String?
  operatorActorName String?
  operatorNotes String?
  @@index([customerId, createdAt])
  @@index([driverId, status])
  @@index([status, service])
  @@index([status, createdAt])
}
model TariffGroup {
  id String @id
  title String
  nissanBaseToman Int?
  nissanPerKmToman Int?
  flatbedBaseToman Int?
  flatbedPerKmToman Int?
  version String
  models VehicleModel[]
}
model VehicleModel {
  id String @id
  name String
  normalizedName String @unique
  aliases String[]
  searchText String
  groupId String
  group TariffGroup @relation(fields: [groupId], references: [id])
  requests AssistanceRequest[]
  @@index([groupId])
}
model Payment {
  id String @id @default(uuid())
  requestId String @unique
  request AssistanceRequest @relation(fields: [requestId], references: [id])
  method String @default("GATEWAY")
  cashReportedAt DateTime?
  cashWalletEntry WalletEntry?
  walletDebit WalletDebit?
  status String @default("AWAITING_PAYMENT")
  serviceToman Int
  partsToman Int
  amountToman Int
  commissionPercent Int
  commissionToman Int
  driverShareToman Int
  cardNumber String?
  accountName String?
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  attempts PaymentAttempt[]
  earning DriverEarning?
  checkouts GatewayCheckout[]
}
model GatewayCheckout {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  paymentId String?
  payment Payment? @relation(fields:[paymentId],references:[id])
  purpose String
  mode String
  amountToman Int
  status String @default("CREATING")
  idempotencyKey String
  authority String? @unique
  refId String?
  merchantHash String
  errorCode String?
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  walletEntry WalletEntry?
  @@unique([userId,idempotencyKey])
  @@index([paymentId,status])
  @@index([userId,createdAt])
}
model WalletEntry {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  checkoutId String? @unique
  checkout GatewayCheckout? @relation(fields:[checkoutId],references:[id])
  receiptId String? @unique
  receipt WalletReceipt? @relation(fields:[receiptId],references:[id])
  paymentId String? @unique
  payment Payment? @relation(fields:[paymentId],references:[id])
  amountToman Int
  mode String
  createdAt DateTime @default(now())
  @@index([userId,mode,createdAt])
}
model WalletDebit {
  goldFundingId String? @unique
  goldFunding GoldFunding? @relation(fields:[goldFundingId],references:[id])
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  paymentId String? @unique
  payment Payment? @relation(fields:[paymentId],references:[id])
  hallOrderId String? @unique
  hallOrder HallOrder? @relation(fields:[hallOrderId],references:[id])
  amountToman Int
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model PaymentAttempt {
  id String @id @default(uuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  bankReference String @unique
  transferredAt DateTime
  status String @default("SUBMITTED")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?
  @@index([paymentId, createdAt])
}
model DriverEarning {
  id String @id @default(uuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id])
  driverId String
  driver User @relation(fields: [driverId], references: [id])
  amountToman Int
  commissionToman Int
  createdAt DateTime @default(now())
  @@index([driverId, createdAt])
}
model DriverLocation {
  driverId String @id
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude Float
  longitude Float
  point Unsupported("geography(Point,4326)")?
  recordedAt DateTime
}
model Outbox {
  id String @id @default(uuid())
  requestId String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt])
}

model UserLocation {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude Float
  longitude Float
  province String
  recordedAt DateTime
  @@index([province])
}

enum MarketCondition {
  UNKNOWN
  NEW
  REFURBISHED
  USED
}
enum MarketAuthenticity {
  GENUINE
  OEM
  AFTERMARKET
  UNKNOWN
}
enum MarketReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
enum MarketRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model MarketCategory {
  torobId String? @unique
  sourceUrl String?
  id String @id @default(uuid())
  slug String @unique
  name String
  parentId String?
  parent MarketCategory? @relation("MarketCategoryTree", fields: [parentId], references: [id])
  children MarketCategory[] @relation("MarketCategoryTree")
  active Boolean @default(true)
  products MarketProduct[]
  @@index([parentId])
}
model MarketBrand {
  id String @id @default(uuid())
  name String
  key String @unique
  active Boolean @default(true)
  products MarketProduct[]
}
model MarketCar {
  garageVehicles Vehicle[]
  aliases String[] @default([])
  engineCode String?
  transmission String?
  sourceUrl String?
  catalogCheckedAt DateTime?
  compatibilities MarketProductCompatibility[]
  id String @id @default(uuid())
  key String @unique
  maker String
  model String
  trim String
  fitments MarketFitment[]
}
model MarketProduct {
  torobReference MarketReferencePrice?
  compatibilities MarketProductCompatibility[]
  id String @id @default(uuid())
  name String
  englishName String?
  searchText String
  identityKey String @unique
  categoryId String
  category MarketCategory @relation(fields: [categoryId], references: [id])
  brandId String
  brand MarketBrand @relation(fields: [brandId], references: [id])
  partNumber String?
  oemNumber String?
  condition MarketCondition
  authenticity MarketAuthenticity
  country String?
  description String @default("")
  images String[]
  specifications Json
  fitmentSignature String
  active Boolean @default(true)
  fitments MarketFitment[]
  listings MarketListing[]
  reviews MarketMatchReview[]
  offers MarketOffer[]
  snapshots MarketPriceSnapshot[]
  archives MarketDailyPrice[]
  alerts MarketAlert[]
  minPriceToman Int?
  maxPriceToman Int?
  avgPriceToman Int?
  offerCount Int @default(0)
  dealScore Int @default(0)
  dropPercent Int @default(0)
  summaryAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId, active, minPriceToman, id])
  @@index([brandId, active])
  @@index([active, dealScore, id])
  @@index([active, minPriceToman, id])
  @@index([active, createdAt, id])
  @@index([partNumber, brandId])
  @@index([oemNumber, brandId])
}
model MarketFitment {
  id String @id @default(uuid())
  productId String
  product MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  carId String
  car MarketCar @relation(fields: [carId], references: [id])
  yearFrom Int
  yearTo Int
  @@unique([productId, carId, yearFrom, yearTo])
  @@index([carId, yearFrom, yearTo])
}
model MarketSource {
  nextCursor String?
  configVersion Int @default(1)
  id String @id @default(uuid())
  name String
  kind String
  adapter String
  baseUrl String
  allowedHosts String[]
  config Json
  secretEnv String?
  licenseUrl String?
  permissionExpiresAt DateTime?
  active Boolean @default(false)
  intervalMinutes Int @default(360)
  minDelayMs Int @default(3000)
  maxPages Int @default(25)
  offerTtlHours Int @default(24)
  nextRunAt DateTime @default(now())
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sellers MarketSeller[]
  listings MarketListing[]
  runs MarketCrawlRun[]
  @@unique([kind, baseUrl])
  @@index([active, nextRunAt])
}
model MarketSeller {
  id String @id @default(uuid())
  sourceId String
  source MarketSource @relation(fields: [sourceId], references: [id])
  externalId String
  name String
  domain String @unique
  url String
  logo String?
  contact String?
  active Boolean @default(true)
  reputation Int @default(0)
  verified Boolean @default(false)
  lastCheckedAt DateTime?
  listings MarketListing[]
  @@unique([sourceId, externalId])
}
model MarketListing {
  sourceFingerprint String
  metadataOverrides Json?
  id String @id @default(uuid())
  sourceId String
  source MarketSource @relation(fields: [sourceId], references: [id])
  externalId String
  sellerId String
  seller MarketSeller @relation(fields: [sellerId], references: [id])
  productId String?
  product MarketProduct? @relation(fields: [productId], references: [id])
  title String
  url String
  normalized Json
  fingerprint String
  matchScore Int @default(0)
  matchStatus MarketReviewStatus @default(PENDING)
  checkedAt DateTime
  offer MarketOffer?
  snapshots MarketPriceSnapshot[]
  reviews MarketMatchReview[]
  @@unique([sourceId, externalId])
  @@index([productId, matchStatus])
  @@index([matchStatus, checkedAt])
  @@index([sellerId])
}
model MarketMatchReview {
  id String @id @default(uuid())
  listingId String
  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate MarketProduct? @relation(fields: [candidateId], references: [id])
  score Int
  reasons Json
  fingerprint String
  status MarketReviewStatus @default(PENDING)
  operator String?
  note String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([listingId, fingerprint])
  @@index([status, createdAt])
}
model MarketOffer {
  productId String?
  product MarketProduct? @relation(fields: [productId], references: [id])
  @@index([productId, inStock, expiresAt, priceToman])
  id String @id @default(uuid())
  listingId String @unique
  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceToman Int
  shippingToman Int?
  inStock Boolean
  quantity Int?
  suspicious Boolean @default(false)
  checkedAt DateTime
  expiresAt DateTime
  @@index([expiresAt, inStock, suspicious])
}
model MarketPriceSnapshot {
  fingerprint String
  productId String?
  product MarketProduct? @relation(fields: [productId], references: [id])
  @@index([productId, checkedAt])
  id String @id @default(uuid())
  listingId String
  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  runId String
  run MarketCrawlRun @relation(fields: [runId], references: [id])
  priceToman Int
  shippingToman Int?
  inStock Boolean
  suspicious Boolean
  checkedAt DateTime @default(now())
  @@unique([listingId, runId])
  @@index([listingId, checkedAt])
  @@index([checkedAt])
}
model MarketCrawlRun {
  id String @id @default(uuid())
  sourceId String
  source MarketSource @relation(fields: [sourceId], references: [id])
  status MarketRunStatus @default(QUEUED)
  requestedBy String
  cursor String?
  pages Int @default(0)
  processed Int @default(0)
  errors Int @default(0)
  startedAt DateTime?
  finishedAt DateTime?
  heartbeatAt DateTime?
  createdAt DateTime @default(now())
  logs MarketCrawlLog[]
  snapshots MarketPriceSnapshot[]
  @@index([sourceId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}
// Public reference quotes are not individual shop offers or verified stock.
model MarketDiscoveryQuery {
  seedUrl String? @unique
  active Boolean @default(false)
  generation Int @default(0)
  intervalMinutes Int @default(360)
  maxScrolls Int @default(1000)
  maxProducts Int @default(10000)
  scrollWaitMs Int @default(2000)
  idleRounds Int @default(8)
  limitReached Boolean @default(false)
  links TorobCrawlLink[]
  id String @id @default(uuid())
  key String @unique
  query String
  category String @default("")
  status String @default("QUEUED")
  nextRunAt DateTime @default(now())
  fetchedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results MarketDiscoveryResult[]
  @@index([status, nextRunAt])
}
model MarketReferencePrice {
  productId String? @unique
  product MarketProduct? @relation(fields:[productId],references:[id])
  metadata Json @default("{}")
  torobOffers TorobOffer[]
  id String @id @default(uuid())
  source String @default("TOROB")
  externalId String
  title String
  searchText String
  url String
  priceToman Int?
  suspicious Boolean @default(false)
  checkedAt DateTime
  expiresAt DateTime
  results MarketDiscoveryResult[]
  history MarketReferenceSnapshot[]
  @@unique([source, externalId])
  @@index([expiresAt, suspicious, priceToman])
}
model TorobCrawlLink {
  id String @id @default(uuid())
  queryId String
  query MarketDiscoveryQuery @relation(fields:[queryId],references:[id],onDelete:Cascade)
  externalId String
  url String
  generation Int
  status String @default("PENDING")
  attempts Int @default(0)
  lastError String?
  fetchedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([queryId,externalId])
  @@index([queryId,generation,status])
}
model TorobOffer {
  id String @id @default(uuid())
  referenceId String
  reference MarketReferencePrice @relation(fields:[referenceId],references:[id],onDelete:Cascade)
  externalId String
  sellerKey String
  sellerName String
  url String
  priceToman Int
  available Boolean?
  condition String?
  priceValidUntil DateTime?
  expiresAt DateTime
  checkedAt DateTime
  @@unique([referenceId,externalId])
  @@index([referenceId,available,expiresAt,priceToman])
}
model MarketProductCompatibility {
  id String @id @default(uuid())
  productId String
  product MarketProduct @relation(fields:[productId],references:[id],onDelete:Cascade)
  carId String
  car MarketCar @relation(fields:[carId],references:[id])
  confidence String
  evidenceUrl String
  evidenceText String
  yearFrom Int?
  yearTo Int?
  checkedAt DateTime
  expiresAt DateTime
  @@unique([productId,carId])
  @@index([carId,expiresAt])
}
model MarketCompatibilityRule {
  id String @id @default(uuid())
  name String
  category String
  carKeys String[]
  requirements Json
  evidenceUrl String
  verified Boolean @default(false)
  checkedAt DateTime
  expiresAt DateTime
  @@index([category,verified,expiresAt])
}
model MarketDiscoveryResult {
  queryId String
  query MarketDiscoveryQuery @relation(fields:[queryId], references:[id], onDelete:Cascade)
  referenceId String
  reference MarketReferencePrice @relation(fields:[referenceId], references:[id], onDelete:Cascade)
  rank Int
  seenAt DateTime
  @@id([queryId, referenceId])
  @@index([referenceId])
}
model MarketReferenceSnapshot {
  id String @id @default(uuid())
  referenceId String
  reference MarketReferencePrice @relation(fields:[referenceId], references:[id], onDelete:Cascade)
  runKey String
  priceToman Int
  checkedAt DateTime
  @@unique([referenceId, runKey])
  @@index([referenceId, checkedAt])
  @@index([checkedAt])
}
model MarketCrawlLog {
  id String @id @default(uuid())
  runId String
  run MarketCrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level String
  code String
  message String
  createdAt DateTime @default(now())
  @@index([runId, createdAt])
}
model MarketAlert {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetToman Int
  notifyStock Boolean @default(false)
  sms Boolean @default(false)
  active Boolean @default(true)
  lastEligible Boolean @default(false)
  lastInStock Boolean @default(false)
  cycle Int @default(0)
  createdAt DateTime @default(now())
  notifications MarketNotification[]
  @@unique([userId, productId])
  @@index([active, productId])
}
model MarketNotification {
  id String @id @default(uuid())
  alertId String
  alert MarketAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  cycle Int
  title String
  body String
  readAt DateTime?
  smsState String @default("NOT_REQUESTED")
  smsAttempts Int @default(0)
  createdAt DateTime @default(now())
  @@unique([alertId, cycle])
  @@index([smsState, createdAt])
}

model MarketDailyPrice {
  id String @id @default(uuid())
  productId String
  product MarketProduct @relation(fields: [productId], references: [id])
  listingId String
  day DateTime @db.Date
  minToman Int
  maxToman Int
  avgToman Int
  samples Int
  @@unique([productId, listingId, day])
  @@index([productId, day])
}
model MarketAuditLog {
  id String @id @default(uuid())
  actor String
  action String
  entityId String
  note String
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}


model HallListing {
  showroomId String?
  showroom Showroom? @relation(fields:[showroomId],references:[id])
  @@index([showroomId])
  featuredSlot FeaturedSlot?
  requestedBoosts String[] @default([])
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  status String @default("DRAFT")
  version Int @default(0)
  draft Json @default("{}")
  verifiedContactPhone String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  moderationNote String?
  make String @default("")
  model String @default("")
  trim String @default("")
  makeKey String @default("")
  modelKey String @default("")
  trimKey String @default("")
  searchText String @default("")
  year Int?
  mileage Int?
  city String @default("")
  bodyCondition String @default("")
  technicalCondition String @default("")
  priceToman BigInt?
  inspectionStatus String @default("NOT_INSPECTED")
  inspectionNote String?
  viewCount Int @default(0)
  publishedAt DateTime?
  bumpedAt DateTime?
  featuredUntil DateTime?
  urgentUntil DateTime?
  ladderUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos HallPhoto[]
  orders HallOrder[]
  inquiries HallInquiry[]
  conversations HallConversation[]
  @@index([status, publishedAt])
  @@index([ownerId, updatedAt])
  @@index([makeKey, modelKey, trimKey, year])
}
model HallPhoto {
  id String @id @default(uuid())
  listingId String
  listing HallListing @relation(fields: [listingId], references: [id])
  storageKey String @unique
  readToken String @default(uuid())
  mimeType String
  position Int @default(0)
  createdAt DateTime @default(now())
  @@index([listingId, position])
}
model HallPlan {
  code String @id
  name String
  kind String @default("PLAN")
  description String
  priceToman Int
  originalPriceToman Int?
  services String[]
  terms String
  active Boolean @default(true)
  durationHours Int @default(168)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
}
model HallOrder {
  featuredSlot FeaturedSlot?
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  listingId String
  listing HallListing @relation(fields: [listingId], references: [id])
  listingVersion Int
  action String
  planCode String
  snapshot Json
  amountToman Int
  mode String @default("sandbox")
  status String @default("CREATING")
  idempotencyKey String
  authority String? @unique
  refId String?
  errorCode String?
  supportNote String?
  createdAt DateTime @default(now())
  verifiedAt DateTime?
  activatedAt DateTime?
  walletDebit WalletDebit?
  @@unique([userId, idempotencyKey])
  @@index([listingId, status])
  @@index([createdAt])
}
model HallInquiry {
  id String @id @default(uuid())
  listingId String
  listing HallListing @relation(fields: [listingId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  message String
  contactPhone String
  createdAt DateTime @default(now())
  @@unique([listingId, userId])
}
model HallBanner {
  id String @id @default(uuid())
  title String
  subtitle String @default("")
