POSTGRES_DB=khodrochare
POSTGRES_USER=khodrochare
POSTGRES_PASSWORD=CHANGE_WITH_SETUP_SCRIPT
REDIS_PASSWORD=CHANGE_WITH_SETUP_SCRIPT
DATABASE_URL=postgresql://khodrochare:CHANGE_WITH_SETUP_SCRIPT@postgres:5432/khodrochare?schema=public
REDIS_URL=redis://:CHANGE_WITH_SETUP_SCRIPT@redis:6379
NODE_ENV=production
PORT=4000
API_PORT=4000
API_BIND_ADDRESS=127.0.0.1
# Required only with compose.edge.yaml; DNS must point to your server.
API_DOMAIN=api.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=0
SESSION_DAYS=90
TOW_BASE_TOMAN=200000
TOW_PER_KM_TOMAN=20000
PRICING_VERSION=v1
DISTANCE_MODE=road
OSRM_URL=https://router.project-osrm.org
LOCATION_MAX_AGE_SECONDS=120
UPLOAD_DIR=./uploads

# Photon geocoding endpoint; use your own instance for production traffic.
PHOTON_URL=https://photon.komoot.io

# Run node scripts/setup-admin.js to generate the read-only dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Zarinpal: sandbox works without a live merchant key. Never expose the merchant in clients.
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://api.khodrochare.ir/api/v1/payments/zarinpal/callback
CUSTOMER_APP_URL=https://app.khodrochare.ir
DRIVER_APP_URL=https://driver.khodrochare.ir

# Car Hall always uses Zarinpal sandbox independently from wallet/service payment mode.
# Optional JSON arrays; omit for management through the admin /hall page.
# HALL_PLANS_JSON='[]'
# HALL_BANNERS_JSON='[]'
# See docs/CAR-HALL.md for complete plan/banner formats and deployment.

# Torob-only marketplace; optional notification provider settings follow.
MARKET_RAW_RETENTION_DAYS=180
MARKET_ARCHIVE_RETENTION_DAYS=1095
# MARKET_SMS_URL=https://your-authorized-sms-provider.example/path
# MARKET_SMS_TOKEN=

# Torob-only crawling: configure here; no admin login or panel is required.
TOROB_ENABLED=true
TOROB_INTERVAL_MINUTES=360
TOROB_MAX_SCROLLS=1000
TOROB_MAX_PRODUCTS=10000
TOROB_SCROLL_WAIT_MS=2000
TOROB_IDLE_ROUNDS=8
# Optional authoritative list. One physical line, single-quoted JSON; [] disables all seeds.
# When absent, TOROB_INITIAL_CATEGORY_URL below supplies the single initial category.
# TOROB_SOURCES_JSON='[{"name":"باتری خودرو","url":"https://torob.com/browse/541/","category":"batteries","active":true}]'
# Optional authoritative technical rules; only documented complete specifications may be verified.
# TOROB_COMPATIBILITY_RULES_JSON='[]'
TOROB_CHROME_PATH=/usr/bin/chromium
TOROB_BROWSER_NO_SANDBOX=true
TOROB_SCAN_TIMEOUT_MS=1800000
TOROB_PRICE_TTL_HOURS=24
TOROB_INITIAL_CATEGORY_URL=https://torob.com/browse/541/باتری-خودرو-battery/
