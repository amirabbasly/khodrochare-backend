POSTGRES_DB=khodrochare
POSTGRES_USER=khodrochare
POSTGRES_PASSWORD=CHANGE_WITH_SETUP_SCRIPT
REDIS_PASSWORD=CHANGE_WITH_SETUP_SCRIPT
DATABASE_URL=postgresql://khodrochare:CHANGE_WITH_SETUP_SCRIPT@postgres:5432/khodrochare?schema=public
REDIS_URL=redis://:CHANGE_WITH_SETUP_SCRIPT@redis:6379
NODE_ENV=production
PORT=4000
API_PORT=4000
API_BIND_ADDRESS=127.0.0.1
# Required only with compose.edge.yaml; DNS must point to your server.
API_DOMAIN=api.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=0
SESSION_DAYS=90
TOW_BASE_TOMAN=200000
TOW_PER_KM_TOMAN=20000
PRICING_VERSION=v1
DISTANCE_MODE=road
OSRM_URL=https://router.project-osrm.org
LOCATION_MAX_AGE_SECONDS=120
UPLOAD_DIR=./uploads

# Photon geocoding endpoint; use your own instance for production traffic.
PHOTON_URL=https://photon.komoot.io
